# AdVegaX — example environment for LOCAL DEVELOPMENT.
# Copy to .env and adjust. Never commit real credentials (D15). Staging/production values come
# from a managed secret store; the application refuses insecure settings there.

ENVIRONMENT=local
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-local-only-value-of-at-least-32-characters
LOG_LEVEL=INFO

# Database — one connection per role (DATABASE_SCHEMA §19). Local roles: infrastructure/docker/postgres/init/001_roles.sql
DATABASE_URL_APP=postgresql+psycopg://advegax_app:advegax_app@localhost:5432/advegax
DATABASE_URL_SYSTEM=postgresql+psycopg://advegax_system:advegax_system@localhost:5432/advegax
DATABASE_URL_MIGRATOR=postgresql+psycopg://advegax_migrator:advegax_migrator@localhost:5432/advegax

REDIS_URL=redis://localhost:6379/0

# Public URLs and CORS (comma-separated explicit origins; never "*")
APP_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXY_COUNT=0

# Cookies (staging/production: COOKIE_SECURE=true and __Host- prefixed names)
SESSION_COOKIE_NAME=advegax_session
CSRF_COOKIE_NAME=advegax_csrf
COOKIE_SECURE=false

# Session and token lifetimes — ISO 8601 durations (approved defaults, A15)
SESSION_IDLE_TIMEOUT=PT24H
SESSION_ABSOLUTE_TIMEOUT=P14D
EMAIL_VERIFICATION_TTL=PT24H
PASSWORD_RESET_TTL=PT30M
INVITATION_TTL=P7D

# Throttling (requests per window)
THROTTLE_LOGIN_PER_ACCOUNT_IP_PER_MINUTE=5
THROTTLE_LOGIN_PER_IP_PER_MINUTE=20
THROTTLE_REGISTER_PER_IP_PER_HOUR=5
THROTTLE_EMAIL_ACTION_PER_EMAIL_PER_HOUR=3
THROTTLE_EMAIL_ACTION_PER_IP_PER_HOUR=10
THROTTLE_FAIL_OPEN=false

# Transactional email (local: Mailpit from docker-compose, UI at http://localhost:8025)
EMAIL_BACKEND=smtp
EMAIL_FROM="AdVegaX <no-reply@localhost>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_STARTTLS=false

# Integration foundation (Phase 1B)
API_BASE_URL=http://localhost:8000
CONNECT_STATE_TTL=PT10M
# Token lifecycle (Phase 2A): refresh access tokens this long before expiry; refresh at least this
# often so rotating refresh tokens never lapse; how often the keep-alive sweep runs.
TOKEN_REFRESH_MARGIN=PT10M
TOKEN_KEEPALIVE_INTERVAL=PT24H
SCHEDULE_TOKEN_REFRESH_INTERVAL=PT1H
# Credential encryption key ring: "<version>:<base64 of exactly 32 bytes>", comma-separated.
# The value below is the public LOCAL-ONLY development key; staging/production refuse it.
# Generate a real key with: python -c "import os,base64; print('1:'+base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEYS=1:YWR2ZWdheC1sb2NhbC1kZXYtb25seS1rZXktMzJieSE=
ENCRYPTION_ACTIVE_KEY_VERSION=1

# Background jobs and scheduler
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_DELAY=PT30S
JOB_RETRY_MAX_DELAY=PT1H
JOB_STUCK_AFTER=PT15M
SCHEDULE_EMAIL_SWEEP_INTERVAL=PT1M
SCHEDULE_JOB_RECOVERY_INTERVAL=PT5M

# Outbound requests to platforms (SSRF-safe client)
OUTBOUND_CONNECT_TIMEOUT=PT5S
OUTBOUND_READ_TIMEOUT=PT20S
OUTBOUND_MAX_RESPONSE_BYTES=10485760
OUTBOUND_MAX_REDIRECTS=3
# Streaming downloads of platform bulk exports (2A-06).
OUTBOUND_MAX_DOWNLOAD_BYTES=2147483648
OUTBOUND_DOWNLOAD_TIMEOUT=PT1H

# Shopify (Phase 2A) — leave unset to hide Shopify. JSON list of apps; client secrets come from
# the Shopify Dev Dashboard and must NEVER be committed. One custom-distribution app per merchant.
# SHOPIFY_APPS=[{"client_id":"…","client_secret":"…","shops":["your-store.myshopify.com"]}]
SHOPIFY_API_VERSION=2026-10
SHOPIFY_SCOPES=read_products,read_inventory,read_orders
SHOPIFY_INSTALL_MAX_AGE=PT5M
# Shopify bulk exports: allowlisted download hosts; history allowed without read_all_orders.
SHOPIFY_BULK_DOWNLOAD_HOSTS=storage.googleapis.com
SHOPIFY_DEFAULT_ORDER_HISTORY=P60D
# Google Ads (Phase 3) — off unless switched on AND all three are set. The client secret and the
# developer token must NEVER be committed: put them in your local, untracked settings file.
GOOGLE_ADS_ENABLED=false
# GOOGLE_ADS_CLIENT_ID=…apps.googleusercontent.com
# GOOGLE_ADS_CLIENT_SECRET=…
# GOOGLE_ADS_DEVELOPER_TOKEN=…
GOOGLE_ADS_API_VERSION=v25
# Meta Ads (Phase 4) — off unless switched on AND the app id, app secret and Facebook Login for
# Business configuration id are set. The app secret must NEVER be committed.
META_ADS_ENABLED=false
# META_APP_ID=…
# META_APP_SECRET=…
# META_LOGIN_CONFIG_ID=…
META_API_VERSION=v26.0
# Google Analytics 4 (Phase 5) — off unless switched on AND the Google OAuth client above
# (GOOGLE_ADS_CLIENT_ID / _SECRET, shared with Google Ads) is set. No developer token needed.
GOOGLE_ANALYTICS_ENABLED=false
GOOGLE_ANALYTICS_API_VERSION=v1beta
# Exchange rates (Phase 6): the ECB's daily reference rates and Nepal Rastra Bank's NPR rates,
# read every 6 hours. Off until switched on; the network must allow data-api.ecb.europa.eu and
# www.nrb.org.np. No account or key is needed.
FX_ENABLED=false
# AI campaign planner (Phase 8): Anthropic's Claude API. Off until switched on AND a key is set.
# Put the key only in your local, untracked settings file — never in the repository or a chat.
# The network must allow api.anthropic.com. Prices (USD per million tokens) are optional; without
# them the usage view says "No price set".
AI_ENABLED=false
# ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_MAX_OUTPUT_TOKENS=4000
AI_TIMEOUT=PT60S
AI_DAILY_RUNS=20
AI_MAX_RETRIES=1
# AI_PRICE_INPUT_PER_MTOK=
# AI_PRICE_OUTPUT_PER_MTOK=
# What the planner shows the model: the last N complete days, and a recent window (8-03).
PLANNER_CONTEXT_DAYS=90
PLANNER_RECENT_DAYS=30
# Strategy checks (8-04): how far a target may be from the business's own history (times), and
# each platform's minimum daily budget in US dollars (converted with the latest rate).
PLANNER_TARGET_FACTOR=3
PLANNER_MIN_DAILY_GOOGLE_ADS_USD=1
PLANNER_MIN_DAILY_META_ADS_USD=1
# Creative engine (Phase 9): drafts per platform, image limits and where images are kept.
CREATIVE_CONCEPTS=3
ASSET_MAX_BYTES=10485760
ASSET_MIN_SIDE=600
ASSET_MAX_PIXELS=40000000
# local (a folder on the server) or s3 (any S3-compatible store; keys only in this file).
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=var/storage
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Action Engine (Phase 10A): the only way AdVegaX changes an ad account. Off until switched on;
# each connection must also be allowed ("Allow changes"). Limits per change and per account.
ACTIONS_ENABLED=false
ACTIONS_MAX_INCREASE_PERCENT=50
ACTIONS_MAX_DECREASE_PERCENT=90
ACTIONS_BUDGET_CHANGE_INTERVAL=PT1H
ACTIONS_DAILY_LIMIT_PER_ACCOUNT=50
ACTIONS_PENDING_TTL=P7D
ACTIONS_RECONCILE_DELAY=PT1M
ACTIONS_RECONCILE_ATTEMPTS=5
# Meta: the Login for Business configuration that also asks for ads_management (changes).
# META_WRITE_LOGIN_CONFIG_ID=…
# Recommendations (Phase 11): the daily look of running campaigns (fixed rules; the AI only
# explains). Nothing is changed without approval. Per-organization thresholds are in Settings.
OPTIMIZATION_ENABLED=true
OPTIMIZATION_RUN_HOUR=6
OPTIMIZATION_VALID_FOR=PT72H
OPTIMIZATION_QUIET_PERIOD=P14D
OPTIMIZATION_REFRESHES_PER_DAY=3
# Autopilot (Phase 12): off by default; only listed organizations (comma-separated ids) may
# use it, and only after AUTOPILOT_READY_CHANGES verified changes from approved advice.
AUTOPILOT_ENABLED=false
# AUTOPILOT_ORGANIZATIONS=…
AUTOPILOT_READY_CHANGES=5
# Billing (Phase 13): off by default — every organization keeps full use. Stripe keys go only
# in your local, untracked settings file (test-mode keys first); never in the repository.
BILLING_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_…
# STRIPE_WEBHOOK_SECRET=whsec_…
# STRIPE_API_VERSION=…   (the version checked in Step 0)
STRIPE_WEBHOOK_TOLERANCE=PT5M
BILLING_CURRENCY=aud
BILLING_TRIAL_DAYS=14
BILLING_TRIAL_PLAN=growth
BILLING_PAYMENT_GRACE=P7D
BILLING_TRIAL_REMINDER=P3D
BILLING_RECONCILE_INTERVAL=P1D
SCHEDULE_BILLING_TICK=PT1H
# Never charged, Scale limits (comma-separated organization ids), e.g. your own businesses.
# BILLING_COMPLIMENTARY_ORGANIZATIONS=…
# Agency mode (Phase 14): off by default — grants are ignored and the agency pages hidden.
AGENCY_ENABLED=false
# Data retention (Phase 15): off by default. When on, unlinked stores, ad accounts and analytics
# properties are deleted with their imported data after this long; audit logs are kept.
RETENTION_ENABLED=false
DATA_RETENTION_AFTER_REMOVAL=P90D
SCHEDULE_RETENTION_INTERVAL=P1D
# Commerce import (2A-06): longest history (13 months), export polling, batch size.
COMMERCE_HISTORY_WINDOW=P395D
COMMERCE_BULK_POLL_INTERVAL=PT30S
COMMERCE_IMPORT_BATCH_SIZE=500
# Keeping stores up to date (2A-07): reconciliation schedule, overlap, deep window,
# dead-chain limit, webhook coalescing window.
SCHEDULE_COMMERCE_RECONCILE_INTERVAL=PT1H
SCHEDULE_COMMERCE_DEEP_INTERVAL=PT24H
COMMERCE_RECONCILE_OVERLAP=PT10M
COMMERCE_DEEP_WINDOW=P30D
COMMERCE_CHAIN_STALE_AFTER=PT6H
COMMERCE_FETCH_COALESCE=PT5M
# Webhook intake (2A-05): replay window (keep above Shopify's 4-hour retries), clock skew,
# metadata retention, purge schedule, per-IP limit.
WEBHOOK_MAX_AGE=PT6H
WEBHOOK_CLOCK_SKEW=PT5M
WEBHOOK_RETENTION=P30D
SCHEDULE_WEBHOOK_PURGE_INTERVAL=PT6H
THROTTLE_WEBHOOK_PER_IP_PER_MINUTE=600
